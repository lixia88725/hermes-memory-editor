# Deny by default: only individually audited source/metadata may be staged.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/GUIDE.md
!/docs/
/docs/*
!/docs/images/
/docs/images/*
!/docs/images/editor-demo.png
!/server.py
!/local_history.py
!/launcher.py
!/editor.html
!/vditor-adapter.js
!/vditor-editor.css
!/test_history.py
!/test_loading.py

# Open directory traversal only; never allow arbitrary descendants.
!/vendor/
/vendor/*
!/vendor/SHA256SUMS.json
!/vendor/dependency.json
!/vendor/vditor/
/vendor/vditor/*
!/vendor/vditor/LICENSE
!/vendor/vditor/package.json
!/vendor/vditor/dist/
/vendor/vditor/dist/*
!/vendor/vditor/dist/index.css
!/vendor/vditor/dist/index.min.js
!/vendor/vditor/dist/css/
/vendor/vditor/dist/css/*
!/vendor/vditor/dist/css/content-theme/
/vendor/vditor/dist/css/content-theme/*
!/vendor/vditor/dist/css/content-theme/dark.css
!/vendor/vditor/dist/css/content-theme/light.css
!/vendor/vditor/dist/js/
/vendor/vditor/dist/js/*
!/vendor/vditor/dist/js/i18n/
/vendor/vditor/dist/js/i18n/*
!/vendor/vditor/dist/js/i18n/zh_CN.js
!/vendor/vditor/dist/js/icons/
/vendor/vditor/dist/js/icons/*
!/vendor/vditor/dist/js/icons/ant.js
!/vendor/vditor/dist/js/lute/
/vendor/vditor/dist/js/lute/*
!/vendor/vditor/dist/js/lute/lute.min.js
!/notices/
/notices/*
!/notices/DIFF-MATCH-PATCH-LICENSE
!/notices/HEROICONS-LICENSE
!/notices/LUTE-LICENSE
!/notices/THIRD-PARTY-NOTICES.txt
!/notices/provenance.json

# Defense in depth, including inside otherwise traversable directories.
**/history.git/
**/backups/
**/locks/
**/runtime*.json
**/*.lock
**/*.log
**/logs/
**/.env
**/.env.*
**/env/
**/config/
**/config.*
**/auth.json
**/credentials*
**/__pycache__/
**/*.py[cod]
**/.DS_Store
**/*.app/
**/*.icns
**/overtype*
**/ldt-*
**/ldt.css
